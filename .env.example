# Copy to .env (run.bat does this for you and fills in random secrets).
DJANGO_SETTINGS_MODULE=cyberquest.settings.prod
DJANGO_SECRET_KEY=change-me
FIELD_ENCRYPTION_KEY=
LICENSE_SECRET=everest-cyberquest-2026
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DEMO_MODE=1
HOST_PORT=8000
# Database: sqlite (default) or postgres
DATABASE_ENGINE=sqlite
POSTGRES_DB=cyberquest
POSTGRES_USER=cyberquest
POSTGRES_PASSWORD=change-me
# Set HTTPS=1 only when the site is served over HTTPS (turns on secure cookies, redirect and HSTS)
HTTPS=0
# Knowledge-base (RAG) service
RAG_BASE_URL=http://127.0.0.1:9000
RAG_SERVICE_KEY=change-me

# Front-end addresses (React dev server) allowed to call the public read-only API, comma separated
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
