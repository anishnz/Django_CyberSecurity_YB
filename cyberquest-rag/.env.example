# Shared secret with CyberQuest. run.bat and run_local.bat create it in the main .env for you.
# (by hand: python -c "import secrets;print(secrets.token_urlsafe(32))")
RAG_SERVICE_KEY=change-me
# Where the vector DB and model_config.json are stored
RAG_DATA_DIR=./data
# Embedding model (downloaded once from Hugging Face on first start)
RAG_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_MIN_SCORE=0.2
# Optional first-start AI model (the Super Admin can change it later on the Knowledge Base page)
RAG_LLM_BASE_URL=https://api.deepseek.com/v1
RAG_LLM_MODEL=deepseek-chat
RAG_LLM_API_KEY=
